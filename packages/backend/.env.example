PORT=5000
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_ACCESS_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
NODE_ENV=development

# Comma-separated list of allowed frontend origins (production only)
# In development, all origins are allowed.
ALLOWED_ORIGINS=https://shiftflow-frontend-ten.vercel.app,http://localhost:3000

# Sentry DSN for error tracking (get from sentry.io)
SENTRY_DSN=

# Google Gemini API key (server-side). Get this from Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key
# Optional — override the default model
GEMINI_MODEL=gemini-3.6-flash

# Web Push (VAPID). Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@shiftflow.app

# Optional — if left blank, emails are skipped (in-app notifications still work)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ShiftFlow <no-reply@shiftflow.app>
